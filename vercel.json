{
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://wobz-ver-1-1.onrender.com/api/:path*" },
    { "source": "/:path*", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/(.*)\\.js", "headers": [{ "key": "Cache-Control", "value": "public, max-age=300, must-revalidate" }] },
    { "source": "/(.*)\\.css", "headers": [{ "key": "Cache-Control", "value": "public, max-age=300, must-revalidate" }] }
  ]
}
